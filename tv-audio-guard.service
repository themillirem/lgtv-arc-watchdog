[Unit]
Description=LG TV sound output watchdog (force HDMI ARC)
After=network-online.target
Wants=network-online.target

[Service]
# Adjust paths and TV IP to your install
ExecStart=/opt/tv-audio-guard/venv/bin/python3 /opt/tv-audio-guard/guard.py 192.168.0.21
Restart=always
RestartSec=5
# Type=notify + WatchdogSec turns on systemd's own liveness check: guard.py
# sends a heartbeat every poll (see _sd_notify() in guard.py) via the
# NOTIFY_SOCKET systemd provides for this unit type. If ~90s pass with no
# heartbeat, systemd assumes the process has hung and force-restarts it,
# rather than trusting `systemctl status` forever -- which is exactly what
# happened on 2026-07-27: this service sat completely frozen for ~11 hours
# while still reporting "active (running)" the whole time, because the
# process itself never crashed, it just deadlocked on a hung TV handshake.
# guard.py's own --connect-timeout/--poll-timeout are the real fix for that
# specific hang; this is a backstop in case some other, not-yet-imagined
# hang ever slips past those.
Type=notify
NotifyAccess=main
WatchdogSec=90
# Second backstop layer, added 2026-08-04: even with the timeouts above
# bounding each hang, a *chronic* connect failure (TCP/websocket ports open,
# but the SSAP handshake with the TV never completes -- seen this day, TV
# reachable but every poll cycle timing out) never trips WatchdogSec, because
# each cycle still finishes and reports a heartbeat before the 90s deadline;
# it just never succeeds. That let memory climb to 600M+ over 2 days with
# nothing forcing a restart. MemoryMax force-restarts (via Restart=always)
# if RSS ever exceeds a healthy multiple of the ~20M baseline; RuntimeMaxSec
# forces a clean daily restart regardless, catching any other slow-leak or
# stuck-state failure mode we haven't seen yet.
MemoryAccounting=yes
MemoryMax=300M
RuntimeMaxSec=1d

[Install]
WantedBy=multi-user.target
